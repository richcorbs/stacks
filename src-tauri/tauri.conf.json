{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stacks",
  "version": "0.4.28",
  "identifier": "com.richcorbs.stacks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stacks",
        "width": 1200,
        "height": 800,
        "backgroundColor": "#080b10",
        "dragDropEnabled": true,
        "titleBarStyle": "Transparent",
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0M0Y5RjYxMDMwQzIwMDQKUldRRUlBd0RZWjgvaEFzKzlWckZLQ1dGUUh0NFBLZThiaVNhMWFWdStTM0VaVVRqVThTWWk2a04K",
      "endpoints": [
        "https://github.com/richcorbs/stacks/releases/latest/download/latest.json"
      ]
    }
  }
}
