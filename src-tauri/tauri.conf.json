{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stacks Tauri",
  "version": "0.1.0",
  "identifier": "com.richcorbs.stacks-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stacks Tauri",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool"
  }
}
