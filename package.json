{
  "name": "stacks",
  "version": "0.5.92",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "test:chat-scroll": "node tests/pi-chat-scroll.mjs",
    "test:terminal-dependencies": "node tests/terminal-dependencies.mjs",
    "test:terminal-reflow": "node tests/terminal-reflow.mjs",
    "test:terminal-reflow-pty": "node tests/terminal-reflow-pty.mjs",
    "seed:dev": "cargo run --manifest-path src-tauri/Cargo.toml --example seed_dev_data",
    "build": "node scripts/check-kanban-contract.mjs && node scripts/generate-kanban-boundary.mjs --check && tsc && vite build",
    "kanban:contract:generate": "node scripts/generate-kanban-boundary.mjs",
    "test": "node scripts/check-kanban-contract.mjs && node scripts/generate-kanban-boundary.mjs --check && node --test scripts/kanban-boundary.check.mjs && vitest run",
    "check:version": "node scripts/release.mjs check-version",
    "version:set": "node scripts/release.mjs set-version",
    "release:build": "TAURI_SIGNING_PRIVATE_KEY=\"$(cat $HOME/.tauri/stacks-updater.key)\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD=\"$(cat $HOME/.tauri/stacks-updater.password)\" tauri build --bundles app",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:stage-build": "node scripts/release.mjs build",
    "release:publish": "node scripts/release.mjs draft",
    "release:finalize": "node scripts/release.mjs publish",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
